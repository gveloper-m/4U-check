# ── Git ──────────────────────────────────────────────────────────────────────
.git
web-app/.gitignore
.gitattributes
.github

# ── Sensitive files ───────────────────────────────────────────────────────────
web-app/.env
web-app/.env.*
!web-app/.env.example
app-deploy/.env

# ── Heavy directories (rebuilt inside Docker) ─────────────────────────────────
web-app/vendor/
web-app/node_modules/
web-app/chrome/
chrome/

# ── Build artefacts ───────────────────────────────────────────────────────────
web-app/public/hot
web-app/public/storage
web-app/public/fonts-manifest.dev.json

# ── Generated bootstrap cache (stale on server; regenerated by artisan) ───────
web-app/bootstrap/cache/packages.php
web-app/bootstrap/cache/services.php

# ── Writable runtime directories (replaced by named volumes) ─────────────────
web-app/storage/logs/*
web-app/storage/framework/cache/*
web-app/storage/framework/sessions/*
web-app/storage/framework/views/*
web-app/storage/app/*

# ── Development tools ─────────────────────────────────────────────────────────
web-app/.editorconfig
web-app/.phpactor.json
web-app/.phpunit.cache
web-app/.phpunit.result.cache
web-app/phpunit.xml
web-app/tests/
web-app/*.md

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
.zed/
.nova/
web-app/_ide_helper.php
web-app/Homestead.json
web-app/Homestead.yaml

# ── Deployment scripts not needed in build context ───────────────────────────
app-deploy/scripts/
app-deploy/compose.yaml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
