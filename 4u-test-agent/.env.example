# ─────────────────────────────────────────────────
# 4uTest MCP Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Agent token — copy from your 4uTest dashboard → MCP Agent tab
AGENT_TOKEN=paste-your-token-here

# Port the MCP SSE server listens on inside the container
MCP_SERVER_PORT=8765

# Backup retention: number of ZIP snapshots to keep before rotating
MAX_BACKUPS=10

# Cron time for scheduled daily backups (UTC)
BACKUP_HOUR=2
BACKUP_MINUTE=0

# Seconds between heartbeats (default 60)
HEARTBEAT_INTERVAL=60
