# ─────────────────────────────────────────────────
# 4uTest MCP Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Port the MCP SSE server listens on inside the container
MCP_SERVER_PORT=8765

# Agent token — copy from your 4uTest dashboard (Agents tab)
AGENT_TOKEN=paste-your-token-here

# 4uTest platform URL (change only if self-hosting)
FOURTEST_API_URL=https://4utest.io

# How many seconds between heartbeats to the 4uTest platform
HEARTBEAT_INTERVAL=60

# Backup retention: number of zip snapshots to keep before rotating
MAX_BACKUPS=10

# Cron expression for scheduled daily backups (default: 2 AM every day)
# Format: "hour minute"  e.g. "2 0" = 02:00
BACKUP_HOUR=2
BACKUP_MINUTE=0
