# ══════════════════════════════════════════════════════════════════════════════
# 4uTest – Production Environment
# Copy this file to .env and fill in ALL values before first deploy.
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Domain & SSL ──────────────────────────────────────────────────────────────
# The public domain that Nginx and Let's Encrypt will use.
DOMAIN=your-domain.com
# Email for Let's Encrypt expiry notifications.
CERTBOT_EMAIL=admin@your-domain.com

# ── Laravel application ───────────────────────────────────────────────────────
APP_NAME=4uTest
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL 8.4) ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=4utest_prod
DB_USERNAME=4utest_user
# Strong password – no special chars that break shell quoting
DB_PASSWORD=CHANGE_ME_DB_PASS
# Root password used only by the MySQL container healthcheck
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASS

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production — ensures session cookie is only sent over HTTPS
SESSION_SECURE_COOKIE=true

# ── Cache & Queue (Redis 7) ───────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASS
# IMPORTANT: must be null for port 587 STARTTLS (Brevo). Do NOT use "tls".
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="4uTest"
# Admin email for support ticket notifications (defaults to MAIL_FROM_ADDRESS)
ADMIN_SUPPORT_EMAIL=support@your-domain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_live_REPLACE_ME
STRIPE_SECRET=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Legacy fallback – prefer the two below
STRIPE_PRICE_ID=price_REPLACE_ME
# Base plan prices: €9.99/month and €99.99/year (both excl. VAT)
STRIPE_MONTHLY_PRICE_ID=price_REPLACE_MONTHLY
STRIPE_YEARLY_PRICE_ID=price_REPLACE_YEARLY
# Per-extra-site add-on prices: +€4.99/month or +€49.99/year
STRIPE_MONTHLY_EXTRA_SITE_PRICE_ID=price_REPLACE_EXTRA_MONTHLY
STRIPE_YEARLY_EXTRA_SITE_PRICE_ID=price_REPLACE_EXTRA_YEARLY
# Set to true once Stripe Tax is enabled in your Stripe dashboard
STRIPE_TAX_ENABLED=false
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=el_GR

# ── Trusted proxies (required when behind Nginx) ──────────────────────────────
TRUSTED_PROXIES=*
TRUSTED_HOSTS=your-domain.com

# ── Chromium path ──────────────────────────────────────────────────────────────
# Not needed by default: Browsershot auto-detects Puppeteer's own downloaded
# Chrome-for-Testing build (installed at image build time). Only set CHROME_PATH
# if you need to force a specific browser binary instead.

# ── Mistral AI (optional – only needed for AI blog post generation) ───────────
MISTRAL_API_KEY=

# ── Elorus (Greek invoicing & myDATA / ΑΑΔΕ) ─────────────────────────────────
# Get your API token from: Elorus → Settings → API & Integrations
ELORUS_API_TOKEN=
ELORUS_ORGANIZATION_ID=
# Look up these IDs via the Elorus API before going live:
#   Tax 24%:  GET https://api.elorus.com/v1.0/{org_id}/taxdefinitions/
#   Doctypes: GET https://api.elorus.com/v1.0/{org_id}/documenttypes/
#   Find "Τιμολόγιο Πώλησης" (1.1) for ELORUS_DOCTYPE_INVOICE_ID
#   Find "Απόδειξη Λιανικής" (11.1) for ELORUS_DOCTYPE_RECEIPT_ID
ELORUS_TAX_24_ID=
ELORUS_DOCTYPE_INVOICE_ID=
ELORUS_DOCTYPE_RECEIPT_ID=
